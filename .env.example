# Public address of the site, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Contact form email delivery (https://resend.com). Keep the real key in Vercel, never in git.
RESEND_API_KEY=
# Optional. Where form messages go. Defaults to rabiul.devs@gmail.com (the Resend account email).
CONTACT_TO=
# Optional. Needs a domain verified in Resend. Without it, Resend's test sender is used.
CONTACT_FROM=
